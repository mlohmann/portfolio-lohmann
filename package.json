{
  "name": "portfolio-lohmann",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@tanstack/react-query": "^5.71.10",
    "@tanstack/react-router": "^1.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^6.6.0"
  },
  "scripts": {
    "lint": "eslint src .storybook scripts/*.mjs tests/*.mjs *.config.ts eslint.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:production": "node scripts/test-production.mjs",
    "test:all": "npm test && npm run test:tooling && npm run test:production",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "supabase:prepare": "node scripts/generate-supabase-import.mjs",
    "supabase:upload-images": "node scripts/upload-supabase-images.mjs",
    "supabase:upload-data": "node scripts/upload-supabase-data.mjs",
    "typecheck": "tsc --noEmit",
    "images:prepare": "python3 scripts/prepare-responsive-images.py",
    "test:tooling": "node --test tests/tooling.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-actions": "8.6.19",
    "@storybook/addon-essentials": "8.6.19",
    "@storybook/addon-interactions": "8.6.19",
    "@storybook/addon-links": "8.6.19",
    "@storybook/addon-onboarding": "8.6.19",
    "@storybook/blocks": "8.6.19",
    "@storybook/node-logger": "8.6.19",
    "@storybook/react": "8.6.19",
    "@storybook/react-vite": "8.6.19",
    "@storybook/test": "8.6.19",
    "@storybook/testing-library": "0.2.2",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^0.6.15",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "puppeteer-core": "^25.16.0",
    "storybook": "8.6.19",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.23.4 <23",
    "npm": "10.9.9"
  },
  "packageManager": "npm@10.9.9"
}
